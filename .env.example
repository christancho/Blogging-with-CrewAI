# CrewAI Blog Generation System - Environment Variables
# Copy this file to .env and fill in your actual API keys

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================
# The system supports ANY LLM provider (OpenAI, Anthropic, OpenRouter, local models, etc.)
# Configure the endpoint, API key, model name, and temperature below.

# LLM API Base URL (Chat Completions Endpoint)
# - OpenAI: https://api.openai.com/v1
# - Anthropic: https://api.anthropic.com/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Local (Ollama): http://localhost:11434/v1
# - Azure OpenAI: https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
LLM_API_BASE_URL=https://api.openai.com/v1

# LLM API Key
# Get from your provider:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/settings/keys
# - OpenRouter: https://openrouter.ai/keys
# - Local models: Often not required (leave as "not-needed")
LLM_API_KEY=your_api_key_here

# LLM Model Name
# IMPORTANT: Must have at least 128K context for blog generation
# OpenAI models:
#   - gpt-4o-mini (128K context, fast, cheap) ✅ RECOMMENDED
#   - gpt-4o (128K context, most capable)
#   - gpt-4-turbo (128K context)
# Anthropic models:
#   - claude-3-5-sonnet-20241022 (200K context)
#   - claude-3-opus-20240229 (200K context)
# OpenRouter models:
#   - anthropic/claude-3-5-sonnet
#   - openai/gpt-4o-mini
# Local models (Ollama):
#   - llama3:70b
#   - mixtral:8x7b
LLM_MODEL_NAME=gpt-4o-mini

# LLM Temperature (0.0 to 1.0)
# Lower = more deterministic, Higher = more creative
# Recommended: 0.7 for blog generation
LLM_TEMPERATURE=0.7

# ============================================================================
# LEGACY OPENAI CONFIGURATION (Deprecated - use LLM_* variables above)
# ============================================================================
# These are kept for backward compatibility but will be removed in future versions
# If LLM_* variables are set, they take precedence
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# ============================================================================
# REQUIRED: BRAVE SEARCH API KEY
# ============================================================================
# Required: Brave Search API Key for web research
# Get your API key from: https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# ============================================================================
# OPTIONAL: GHOST CMS INTEGRATION
# ============================================================================
# Optional: Ghost CMS Integration (for automatic publishing)
# Get your API key from your Ghost admin panel
GHOST_API_KEY=your_ghost_cms_api_key_here
GHOST_API_URL=https://your-ghost-site.com
GHOST_AUTHOR_ID=1
