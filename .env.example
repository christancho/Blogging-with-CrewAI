# CrewAI Blog Generation System - Environment Variables
# Copy this file to .env and fill in your actual API keys

# Required: OpenAI API Key for the AI agents
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Required: Brave Search API Key for web research
# Get your API key from: https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Optional: Ghost CMS Integration (for automatic publishing)
# Get your API key from your Ghost admin panel
GHOST_API_KEY=your_ghost_cms_api_key_here
GHOST_API_URL=https://your-ghost-site.com
GHOST_AUTHOR_ID=1

# Optional: Model Configuration
# Recommended: gpt-4o-mini (128K context, fast, cost-effective) - BEST FOR THIS WORKFLOW
# Alternative: gpt-4o (128K context, more capable but more expensive)
# NOTE: gpt-5-mini has only 8K context which is TOO SMALL for blog generation
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
